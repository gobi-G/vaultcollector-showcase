# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Environment
EXPO_PUBLIC_APP_ENV=development

# Pokemon TCG API (free key from https://dev.pokemontcg.io/)
EXPO_PUBLIC_POKEMON_TCG_API_KEY=

# RevenueCat (https://app.revenuecat.com)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry (https://sentry.io)
EXPO_PUBLIC_SENTRY_DSN=

# Legal operator details shown in Impressum / Privacy Policy / Terms
EXPO_PUBLIC_LEGAL_OWNER_NAME=
EXPO_PUBLIC_LEGAL_STREET=
EXPO_PUBLIC_LEGAL_CITY=
EXPO_PUBLIC_CONTACT_EMAIL=

# Optional: prefill the login form in development builds
EXPO_PUBLIC_DEV_LOGIN_EMAIL=
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=
