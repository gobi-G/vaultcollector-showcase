{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_ENV_FILE=.env.development expo start",
    "start:prod": "EXPO_ENV_FILE=.env.production expo start",
    "ios": "EXPO_ENV_FILE=.env.development expo start --ios",
    "ios:prod": "EXPO_ENV_FILE=.env.production expo start --ios",
    "android": "EXPO_ENV_FILE=.env.development expo start --android",
    "android:prod": "EXPO_ENV_FILE=.env.production expo start --android",
    "web": "EXPO_ENV_FILE=.env.development expo start --web",
    "web:prod": "EXPO_ENV_FILE=.env.production expo start --web",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "lint:fix": "eslint . --fix --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --clean",
    "run:ios": "EXPO_ENV_FILE=.env.development expo run:ios",
    "run:android": "EXPO_ENV_FILE=.env.development expo run:android",
    "run:ios:prod": "EXPO_ENV_FILE=.env.production expo run:ios --configuration Release",
    "run:android:prod": "EXPO_ENV_FILE=.env.production expo run:android --variant release",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod": "eas build --profile production --platform all",
    "device:create": "eas device:create",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "^8.5.0",
    "@shopify/flash-list": "^2.3.0",
    "@supabase/supabase-js": "^2.99.2",
    "@tanstack/query-sync-storage-persister": "^5.95.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.95.0",
    "@vault-collector/shared": "workspace:*",
    "expo": "~55.0.6",
    "expo-constants": "^55.0.7",
    "expo-file-system": "^55.0.11",
    "expo-font": "^55.0.4",
    "expo-haptics": "^55.0.9",
    "expo-image": "^55.0.6",
    "expo-image-manipulator": "^55.0.11",
    "expo-linear-gradient": "^55.0.9",
    "expo-linking": "^55.0.7",
    "expo-localization": "^55.0.8",
    "expo-router": "^55.0.5",
    "expo-secure-store": "^55.0.8",
    "expo-sharing": "^55.0.14",
    "expo-splash-screen": "^55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "^55.0.9",
    "i18next": "^25.8.18",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-i18next": "^16.5.8",
    "react-native": "0.83.2",
    "react-native-blob-util": "^0.24.7",
    "react-native-css-interop": "~0.1.22",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-mmkv": "^4.3.0",
    "react-native-purchases": "^9.14.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "^0.7.4",
    "sonner-native": "^0.23.1",
    "tailwindcss": "3.4.17",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/metro-config": "^58.0.21",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~7.0.2"
  },
  "private": true
}
